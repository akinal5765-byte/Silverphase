    "adoption": "Unchanged CineStill 800T metadata alias and back-reflection constants. Profile loader and neutral-print inheritance adapted to Silverphase; back-reflection selected only by the stock's profile preset, preserving existing strong/weak/none overrides. Upstream headroom applied before film exposure in the existing whole-frame stage. Shared catalogue, macOS/iOS controls, sidecars, reset and clipboard updated. Upstream checks adapted to antihalation_mode; exact base-emulsion and whole/strip equality gates added.",
    "licenses": "Profile alias: upstream CC-BY-SA-4.0 distribution. Adopted native implementation and test/fit tools: GPL-3.0-or-later. Andrea Volpato's base measured arrays unchanged."
  },
  "print_balance_calibration": {
    "method_source": "https://github.com/noahhaasis/negs/blob/97d63aaebca9654b041211dea9eebd55dd12b878/crates/spektrafilm-core/src/print_balance.rs",
    "upstream_model": "Spektrafilm experimental 28bf883",
    "driver": "engine/tests/print_balance.cpp",
    "baseline_product_table_sha256": "a09f889bd2c107970ce5a9c39b8a2e5d04c8a725834c3a59be211aa58fe752d8",
    "enlarger_illuminant": "TH-KG3",
    "reference": "0.184 scene-linear grey, fixed C, solve M and Y in linear sRGB before output gamut mapping",
    "acceptance": "Midgrey residual at most 0.00001 and lower average residual on seven grey patches from -3 to +3 EV. Spatial and stochastic effects disabled.",
    "calibrated_pairs": 238,
    "evaluated_pairs": 248,
    "holdout": "Six half-stop patches between -2.5 and +2.5 EV excluded from the seven-point screen. Three rows that passed the initial screen worsened on this holdout and were restored to their previous values.",
    "scope": "Modelled print balance only. Base film and paper measurement arrays and other illuminants retain source values."
  },
